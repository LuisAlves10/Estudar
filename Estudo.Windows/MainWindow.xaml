<Window x:Class="Estudo.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Estudar" Width="1366" Height="913" MinWidth="1000" MinHeight="680" WindowStartupLocation="CenterScreen" Background="{DynamicResource Bg}" Foreground="{DynamicResource Ink}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="14">
 <Grid><Grid.ColumnDefinitions><ColumnDefinition x:Name="NavColumn" Width="192"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0" Padding="16,24,12,16"><DockPanel LastChildFill="True">
   <StackPanel DockPanel.Dock="Top" Margin="8,0,0,32"><TextBlock Text="estudar" FontSize="29" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/><TextBlock Text="Seu espaço de prática" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,5,0,0"/></StackPanel>
   <StackPanel DockPanel.Dock="Bottom"><TextBlock Text="LOCAL E OFFLINE" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" Margin="10,0,0,7"/><TextBlock x:Name="LocalInfo" Text="Seus registros ficam aqui." FontSize="12" Foreground="{DynamicResource Muted}" Margin="10,0,0,4"/></StackPanel>
   <StackPanel x:Name="Navigation"/>
  </DockPanel></Border>
  <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions><ContentControl x:Name="PageHost" Margin="24,22,24,0"/><Border Grid.Row="1" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="24,5,10,3"><TextBlock x:Name="Toast" Text="Tudo pronto · funcionamento local" FontSize="11" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/></Border></Grid>
 </Grid>
</Window>
